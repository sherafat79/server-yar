{
  "name": "serveryar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @serveryar/server --filter web dev",
    "build": "pnpm --filter @serveryar/shared build && pnpm --filter web build && pnpm --filter @serveryar/server build",
    "typecheck": "pnpm -r typecheck",
    "test:dates": "pnpm --filter @serveryar/server exec esbuild ../web/tests/date-input.test.ts --bundle --platform=node --main-fields=module,main --format=cjs --outfile=../web/node_modules/.tmp/date-input.test.cjs && node --test apps/web/node_modules/.tmp/date-input.test.cjs",
    "create-admin": "pnpm --filter @serveryar/server create-admin"
  }
}

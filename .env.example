# HTTP
PORT=8080
# Public URL of the panel (used in links)
PUBLIC_URL=https://panel.example.com

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A COPY SOMEWHERE SAFE — losing it makes stored passwords unrecoverable.
ENCRYPTION_KEY=

# SQLite file
DATABASE_PATH=./data/serveryar.db

# Telegram
TELEGRAM_BOT_TOKEN=
# Channel id (e.g. -1001234567890) or @channelusername; the bot must be an admin of the channel
TELEGRAM_CHANNEL_ID=
# Optional proxy for Telegram API (e.g. http://127.0.0.1:8118)
TELEGRAM_PROXY=

TZ=Asia/Tehran

# Docker Compose: domain Caddy gets a certificate for (DNS A record must point to this server)
DOMAIN=panel.example.com

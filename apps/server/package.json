    "@libsql/client": "^0.18.0",
    "@serveryar/shared": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.14",
    "https-proxy-agent": "^9.1.0",
    "otpauth": "^9.5.2",
    "ping": "^1.0.0",
